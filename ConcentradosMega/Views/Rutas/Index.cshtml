@using ConcentradosMega.Models
@model List<Ruta>
@{ ViewData["Title"] = "Rutas"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Rutas de entrega</h1>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <input type="date" name="fecha" value="@ViewData["Fecha"]" class="form-control" />
            <button class="btn btn-outline-secondary" type="submit">Filtrar</button>
        </form>
        <a asp-action="Crear" class="btn btn-mega text-nowrap"><i class="bi bi-plus-lg"></i> Nueva ruta</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No hay rutas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr><th>Ruta</th><th>Fecha</th><th>Repartidor</th><th>Avance</th><th>Estado</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                var hechas = r.Pedidos.Count(p => p.EstadoEntrega != EstadosEntrega.Pendiente);
                <tr>
                    <td>@r.Nombre</td>
                    <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@r.Repartidor?.NombreCompleto</td>
                    <td>@hechas / @r.Pedidos.Count</td>
                    <td><partial name="_EstadoRuta" model="r.Estado" /></td>
                    <td class="text-end"><a asp-action="Detalle" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Abrir</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
