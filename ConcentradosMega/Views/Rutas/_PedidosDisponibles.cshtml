@using ConcentradosMega.Services
@model List<ConcentradosMega.Models.Pedido>
@if (Model.Count == 0)
{
    <p class="text-muted small mb-0">No hay pedidos confirmados sin ruta.</p>
}
else
{
    <div class="list-group">
        @foreach (var p in Model)
        {
            <label class="list-group-item d-flex gap-2 align-items-start">
                <input class="form-check-input mt-1" type="checkbox" name="pedidoIds" value="@p.Id" />
                <span class="flex-grow-1">
                    <strong>Pedido #@p.Id</strong> · @p.Cliente?.Nombre
                    <span class="d-block small text-muted">@p.Fecha.ToString("dd/MM/yyyy") · @p.Cliente?.Direccion</span>
                </span>
                <span class="text-nowrap">@FacturaService.Colones(p.Total)</span>
            </label>
        }
    </div>
}
