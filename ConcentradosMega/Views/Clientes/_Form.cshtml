@model ConcentradosMega.Models.Cliente

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <label asp-for="Cedula" class="form-label">Cédula</label>
        <input asp-for="Cedula" class="form-control" maxlength="20" />
        <span asp-validation-for="Cedula" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" maxlength="100" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Telefono" class="form-label">Teléfono</label>
        <input asp-for="Telefono" class="form-control" maxlength="20" />
        <span asp-validation-for="Telefono" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Correo" class="form-label">Correo</label>
        <input asp-for="Correo" class="form-control" maxlength="100" />
        <span asp-validation-for="Correo" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Direccion" class="form-label">Dirección</label>
        <input asp-for="Direccion" class="form-control" maxlength="250" />
        <span asp-validation-for="Direccion" class="text-danger small"></span>
    </div>
</div>
